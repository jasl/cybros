#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export RAILS_ENV="${RAILS_ENV:-development}"

if [[ "${RAILS_ENV}" != "development" ]]; then
  echo "bin/ci_e2e must run with RAILS_ENV=development" >&2
  echo "E2E uses the development app and jobs stack; use integration tests for test-environment coverage." >&2
  exit 1
fi

PORT="${E2E_PORT:-3000}"
export E2E_BASE_URL="${E2E_BASE_URL:-http://127.0.0.1:${PORT}}"
export CYBROS_BASE_URL="${CYBROS_BASE_URL:-${E2E_BASE_URL}}"
export CYBROS_AGENT_WORKSPACE_ROOT="${CYBROS_AGENT_WORKSPACE_ROOT:-$PWD/tmp/agent-workspace}"
DRY_RUN="${CI_E2E_DRY_RUN:-0}"

auto_enable_programmable_agent_fixture() {
  if [[ "$#" -eq 0 ]]; then
    return 0
  fi

  for arg in "$@"; do
    case "${arg}" in
      *programmable_agent_*.spec.ts)
        return 0
        ;;
    esac
  done

  return 1
}

if [[ -n "${CI_E2E_PROGRAMMABLE_AGENT_FIXTURE:-}" ]]; then
  FIXTURE_ENABLED="${CI_E2E_PROGRAMMABLE_AGENT_FIXTURE}"
elif auto_enable_programmable_agent_fixture "$@"; then
  FIXTURE_ENABLED="1"
else
  FIXTURE_ENABLED="0"
fi

echo "CI E2E: starting server + jobs"
echo "   base url: ${E2E_BASE_URL}"

mkdir -p tmp tmp/pids "${CYBROS_AGENT_WORKSPACE_ROOT}"

cleanup() {
  echo ""
  echo "CI E2E: stopping server + jobs"
  for pid in "${FIXTURE_PID:-}" "${JOBS_PID:-}" "${SERVER_PID:-}"; do
    [[ -n "${pid}" ]] || continue
    kill "${pid}" 2>/dev/null || true
  done

  for pid in "${FIXTURE_PID:-}" "${JOBS_PID:-}" "${SERVER_PID:-}"; do
    [[ -n "${pid}" ]] || continue
    for _ in {1..40}; do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 0.25
    done
    kill -9 "${pid}" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

if [[ "${FIXTURE_ENABLED}" == "1" ]]; then
  FIXTURE_HOST="${PROGRAMMABLE_AGENT_FIXTURE_HOST:-127.0.0.1}"
  FIXTURE_PORT="${PROGRAMMABLE_AGENT_FIXTURE_PORT:-4319}"
  export PROGRAMMABLE_AGENT_FIXTURE_URL="http://${FIXTURE_HOST}:${FIXTURE_PORT}/rpc"
  export PROGRAMMABLE_AGENT_FIXTURE_HEALTH_URL="http://${FIXTURE_HOST}:${FIXTURE_PORT}/health"

  echo "programmable agent fixture enabled"
  echo "   rpc url: ${PROGRAMMABLE_AGENT_FIXTURE_URL}"
  echo "   health url: ${PROGRAMMABLE_AGENT_FIXTURE_HEALTH_URL}"
  echo "starting programmable-agent fixture"

  bin/programmable_agent_fixture --host "${FIXTURE_HOST}" --port "${FIXTURE_PORT}" >tmp/ci_e2e_programmable_agent_fixture.log 2>&1 &
  FIXTURE_PID="$!"

  for _ in {1..40}; do
    if curl -fsS "${PROGRAMMABLE_AGENT_FIXTURE_HEALTH_URL}" >/dev/null 2>&1; then
      echo "programmable-agent fixture is up"
      break
    fi
    sleep 0.25
  done

  if ! curl -fsS "${PROGRAMMABLE_AGENT_FIXTURE_HEALTH_URL}" >/dev/null 2>&1; then
    echo "❌ programmable-agent fixture did not become ready"
    echo ""
    echo "--- programmable-agent fixture log (tail) ---"
    tail -n 200 tmp/ci_e2e_programmable_agent_fixture.log || true
    exit 1
  fi
fi

if [[ "${DRY_RUN}" == "1" ]]; then
  echo "CI E2E dry run complete"
  exit 0
fi

bundle exec ruby -v >/dev/null
bun run build >/dev/null
bun run build:css >/dev/null
bin/rails db:prepare >/dev/null
bin/rails cybros:ensure_secondary_database_schemas >/dev/null

bin/rails runner - <<'RUBY'
identity = Identity.find_by(email: "admin@example.com")
if identity.nil?
  identity = Identity.create!(email: "admin@example.com", password: "Passw0rd", password_confirmation: "Passw0rd")
end
User.find_or_create_by!(identity: identity) { |u| u.role = :owner }
RUBY

bin/jobs >tmp/ci_e2e_jobs.log 2>&1 &
JOBS_PID="$!"

PIDFILE="tmp/pids/server-e2e-${PORT}.pid"
rm -f "${PIDFILE}"

bin/rails server -b 127.0.0.1 -p "${PORT}" -P "${PIDFILE}" >tmp/ci_e2e_server.log 2>&1 &
SERVER_PID="$!"

echo "waiting for ${E2E_BASE_URL}/up"
for i in {1..60}; do
  if curl -fsS "${E2E_BASE_URL}/up" >/dev/null 2>&1; then
    echo "server is up"
    break
  fi
  sleep 0.5
done

if ! curl -fsS "${E2E_BASE_URL}/up" >/dev/null 2>&1; then
  echo "❌ server did not become ready"
  echo ""
  echo "--- server log (tail) ---"
  tail -n 200 tmp/ci_e2e_server.log || true
  echo ""
  echo "--- jobs log (tail) ---"
  tail -n 200 tmp/ci_e2e_jobs.log || true
  exit 1
fi

echo "running Playwright"
bunx playwright install chromium >/dev/null 2>&1 || true
bunx playwright test "$@"
