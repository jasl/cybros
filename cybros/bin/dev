#!/usr/bin/env ruby

ENV["PORT"] ||= "3000"
VERBOSE = ARGV.include?("--verbose") || ARGV.include?("-v") || ENV["VERBOSE"]
RAILS_ARGS = ARGV - %w[--verbose -v]
PROCFILE = "Procfile.dev"
CLAW_PORT = ENV.fetch("CYBROS_BUNDLED_CLAW_PORT", "4242")
CLAW_BEARER = ENV.fetch("CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER", "secret://bundled-claw:dev")
CLAW_FINGERPRINT = ENV.fetch("CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT", "deployment:bundled-claw:dev")
DEV_STACK_ENV = {
  "RUBY_DEBUG_OPEN" => "true",
  "CYBROS_AGENT_WORKSPACE_ROOT" => File.expand_path("tmp/agent-workspace", Dir.pwd),
  "CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL" => ENV.fetch("CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL", "http://127.0.0.1:#{CLAW_PORT}/rpc"),
  "CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER" => CLAW_BEARER,
  "CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT" => CLAW_FINGERPRINT,
  "CYBROS_BUNDLED_CLAW_PORT" => CLAW_PORT,
}.freeze
Process.exec(*%w[bin/rails server], *RAILS_ARGS) unless File.exist?(PROCFILE)

Signal.trap("INT") { }

if system(*%w[gem list --no-installed --exact --silent foreman])
  puts "Installing foreman..."
  system(*%w[gem install foreman])
end

begin
  in_r, in_w = IO.pipe
  foreman_pid = Process.spawn(
    DEV_STACK_ENV,
    *%w[foreman start -f Procfile.dev -m all=1,web=0 --env /dev/null],
    in: in_r,
    out: (VERBOSE ? STDOUT : "/dev/null"),
    err: (VERBOSE ? STDOUT : "/dev/null"),
    pgroup: true,
  )
  foreman_pgid = Process.getpgid(foreman_pid)
  pid = Process.spawn(DEV_STACK_ENV, *%w[bin/rails server], *RAILS_ARGS)

  Process.wait(pid)
  pid = nil
ensure
  if foreman_pgid
    Process.kill("INT", -foreman_pgid)
    Process.wait(-foreman_pgid)
  end
  begin
    Process.kill("KILL", pid) if pid
  rescue Errno::ESRCH
  end
  in_w&.close
  in_r&.close
end
