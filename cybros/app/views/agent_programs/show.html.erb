<div class="p-6 space-y-6">
  <% bundled_hook_managed_runtime = @agent_program.bundled_source? && @loaded.runtime_surface_status == "missing" %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= @agent_program.name %></h1>
      <p class="opacity-70 text-sm">Source kind: <span class="font-mono"><%= @agent_program.source_kind %></span></p>
      <p class="opacity-70 text-sm">Bundled key: <span class="font-mono"><%= @agent_program.bundled_agent_key.presence || "n/a" %></span></p>
      <p class="opacity-70 text-sm">Local path: <span class="font-mono text-xs"><%= @agent_program.local_path %></span></p>
    </div>
    <%= link_to "Back", agent_programs_path, class: "btn btn-ghost" %>
  </div>

  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">Runtime surface</h2>
      <div class="flex items-center gap-3">
        <span class="badge badge-outline font-mono"><%= bundled_hook_managed_runtime ? "hook-driven" : @loaded.runtime_surface_config.fetch("type", "noop") %></span>
        <% if bundled_hook_managed_runtime %>
          <span class="text-sm opacity-70">Managed by programmable hooks</span>
        <% elsif @loaded.runtime_surface_status == "invalid" %>
          <span class="text-sm opacity-70">Invalid manifest config</span>
        <% elsif @loaded.runtime_surface_status != "configured" %>
          <span class="text-sm opacity-70">Missing from manifest</span>
        <% end %>
      </div>
      <p class="text-sm opacity-70">
        This view only shows the safe runtime summary. Raw agent source files stay out of the standard agent UI.
      </p>
    </div>
  </div>
</div>
