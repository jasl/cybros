<% content_for :header_content do %>
  <div class="flex items-center gap-2">
    <span class="text-sm font-semibold">Dashboard</span>
  </div>
<% end %>

<div class="p-6 space-y-6" data-testid="dashboard-page">
  <div class="overflow-x-auto">
    <div class="stats stats-horizontal w-full bg-base-100 border border-base-300 rounded-box shadow-sm">
      <div class="stat min-w-64">
        <div class="stat-title">LLM providers</div>
        <div class="stat-value text-xl"><%= @provider_count %></div>
        <div class="stat-desc opacity-60">Configured providers</div>
      </div>
      <div class="stat min-w-64">
        <div class="stat-title">Available agents</div>
        <div class="stat-value text-xl"><%= @agent_count %></div>
        <div class="stat-desc opacity-60">Launchable runtimes</div>
      </div>
      <div class="stat min-w-64">
        <div class="stat-title">Runs</div>
        <div class="stat-value text-xl"><%= @run_state_counts.values.sum %></div>
        <div class="stat-desc opacity-60">
          <%= @run_state_counts.fetch("running", 0) %> running · <%= @run_state_counts.fetch("failed", 0) %> failed
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="card bg-base-100 border border-base-300 shadow-sm lg:col-span-3">
      <div class="card-body">
        <div class="flex items-center justify-between gap-3">
          <h2 class="card-title">Agents</h2>
          <span class="text-sm opacity-60"><%= @agents.length %> available</span>
        </div>

        <% if @agents.empty? %>
          <p class="opacity-70">No active agents are currently available.</p>
        <% else %>
          <div class="divide-y divide-base-300">
            <% @agents.each do |agent| %>
              <div
                class="flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between"
                data-testid="dashboard-agent-row"
                data-agent-id="<%= agent.id %>"
                data-bundled-agent-key="<%= agent.bundled_agent_key %>">
                <div class="space-y-1">
                  <div class="font-medium"><%= agent.name %></div>
                  <div class="text-sm opacity-70"><%= agent.description.presence || agent.config_namespace %></div>
                </div>

                <%= form_with url: conversations_path, method: :post, class: "shrink-0", data: { turbo: false } do |form| %>
                  <%= form.hidden_field :agent_id, name: "conversation[agent_id]", value: agent.id %>
                  <button type="submit" class="btn btn-primary btn-sm gap-2">
                    <span class="icon-[lucide--plus] size-4"></span>
                    New conversation
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">Health</h2>

        <% if @provider_count == 0 %>
          <div role="alert" class="alert alert-warning alert-soft text-sm">
            <span class="icon-[lucide--triangle-alert] size-4"></span>
            <span>No LLM providers configured yet.</span>
          </div>
        <% end %>

        <div class="flex flex-wrap items-center gap-2">
          <% invalid_base_url = @provider_health.fetch(:invalid_base_url, 0) %>
          <% missing_credential = @provider_health.fetch(:missing_credential, 0) %>

          <span class="badge <%= invalid_base_url > 0 ? "badge-error" : "badge-success" %> badge-outline">
            Base URL <%= invalid_base_url > 0 ? "invalid" : "ok" %>
            <% if invalid_base_url > 0 %>(<%= invalid_base_url %>)<% end %>
          </span>

          <span class="badge <%= missing_credential > 0 ? "badge-warning" : "badge-success" %> badge-outline">
            Credential <%= missing_credential > 0 ? "missing" : "ok" %>
            <% if missing_credential > 0 %>(<%= missing_credential %>)<% end %>
          </span>
        </div>

        <div class="mt-3 flex items-center gap-2">
          <%= link_to system_settings_llm_providers_path, class: "btn btn-ghost btn-sm gap-2" do %>
            <span class="icon-[lucide--cpu] size-4"></span>
            Manage providers
          <% end %>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">Recent conversations</h2>

        <% if @recent_conversations.empty? %>
          <p class="opacity-70">No conversations yet.</p>
        <% else %>
          <ul class="list">
            <% @recent_conversations.each do |c| %>
              <li class="list-row">
                <div class="list-col-grow">
                  <div class="font-medium truncate"><%= c.title.presence || "(untitled)" %></div>
                  <div class="text-xs opacity-60"><%= c.created_at.to_fs(:short) %></div>
                </div>
                <div>
                  <%= link_to "Open", conversation_path(c), class: "btn btn-ghost btn-sm" %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-sm">
      <div class="card-body">
        <h2 class="card-title">Last run</h2>

        <% if @last_run.nil? %>
          <p class="opacity-70">No runs yet.</p>
        <% else %>
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-outline"><%= @last_run.state %></span>
            <span class="text-sm opacity-70"><%= @last_run.created_at.to_fs(:short) %></span>
          </div>
          <div class="mt-3">
            <%= link_to "Open conversation", conversation_path(@last_run.conversation_id), class: "btn btn-ghost btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
