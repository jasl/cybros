<% node_id = message.fetch("node_id").to_s %>
<% type = message.fetch("node_type").to_s %>
<% turn_id = message.fetch("turn_id", "").to_s %>
<% state = message.fetch("state", "").to_s %>
<% payload = message.fetch("payload", {}) %>
<% payload = {} unless payload.is_a?(Hash) %>
<% metadata = message.fetch("metadata", {}) %>
<% metadata = {} unless metadata.is_a?(Hash) %>
<% run_state = message.fetch("run_state", nil) %>
<% run_state = {} unless run_state.is_a?(Hash) %>
<% action_policy = message.fetch("action_policy", {}) %>
<% action_policy = {} unless action_policy.is_a?(Hash) %>
<% actions = action_policy.fetch("actions", {}) %>
<% actions = {} unless actions.is_a?(Hash) %>
<% retry_action = actions.fetch("retry", {}) %>
<% retry_action = {} unless retry_action.is_a?(Hash) %>
<% start_action = actions.fetch("start", {}) %>
<% start_action = {} unless start_action.is_a?(Hash) %>
<% regenerate_action = actions.fetch("regenerate", {}) %>
<% regenerate_action = {} unless regenerate_action.is_a?(Hash) %>
<% swipe_action = actions.fetch("swipe", {}) %>
<% swipe_action = {} unless swipe_action.is_a?(Hash) %>
<% swipe_current = Integer(swipe_action["current"], exception: false) %>
<% swipe_total = Integer(swipe_action["total"], exception: false) %>
<% swipe_left_available = swipe_action.fetch("left_available", false) == true %>
<% swipe_right_available = swipe_action.fetch("right_available", false) == true %>
<% branch_action = actions.fetch("branch", {}) %>
<% branch_action = {} unless branch_action.is_a?(Hash) %>
<% edit_action = actions.fetch("edit", {}) %>
<% edit_action = {} unless edit_action.is_a?(Hash) %>
<% action_policy_json = json_escape(action_policy.to_json) %>
<% run_state_json = run_state.any? ? json_escape(run_state.to_json) : nil %>
<% preview = payload.dig("output_preview", "content").to_s %>
<% output = payload.dig("output", "content").to_s %>
<% input = payload.dig("input", "content").to_s %>
<% input_attachments = Array(payload.dig("input", "attachments")).select { |entry| entry.is_a?(Hash) } %>
<% terminal = Conversation::TERMINAL_NODE_STATES.include?(state) %>
<% markdown_source = output.presence || preview %>
<% markdown_source = markdown_source.to_s.truncate(20_000, omission: "\n\n… (truncated)") %>
<% error_text = metadata.fetch("error", "").to_s %>
<% reason_text = metadata.fetch("reason", "").to_s %>

<div id="message_<%= node_id %>" data-message-node-id="<%= node_id %>">
  <% if type == Messages::UserMessage.node_type_key %>
    <div
      class="flex justify-end group"
      data-controller="message-actions"
      data-message-actions-node-id-value="<%= node_id %>"
      data-message-actions-role-value="user"
      data-message-actions-action-policy-value="<%= action_policy_json %>">
      <div class="max-w-[70%]">
        <div class="bg-base-200 rounded-3xl px-5 py-3" data-node-id="<%= node_id %>">
          <% if input.present? %>
            <p class="whitespace-pre-wrap text-sm" data-role="user-text"><%= input %></p>
          <% end %>
          <% if input_attachments.any? %>
            <div class="<%= input.present? ? "mt-3" : "" %> space-y-2" data-role="user-attachments">
              <% input_attachments.each do |attachment| %>
                <div class="rounded-2xl border border-base-300 bg-base-100/70 px-3 py-2 text-xs">
                  <div class="font-medium"><%= attachment.fetch("filename", "attachment") %></div>
                  <div class="opacity-60"><%= attachment.fetch("content_type", "application/octet-stream") %></div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="mt-1 flex justify-end gap-1 opacity-60 group-hover:opacity-100">
          <button type="button"
                  class="btn btn-ghost btn-xs"
                  data-message-actions-target="copyButton"
                  data-action="message-actions#copy">
            <span class="icon-[lucide--copy] size-3"></span>
            Copy
          </button>
          <% if edit_action.fetch("available", false) %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="editButton"
                    data-action="message-actions#edit">
              <span class="icon-[lucide--pencil] size-3"></span>
              Edit
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif type == Messages::AgentMessage.node_type_key %>
    <div
      class="flex justify-start group"
      data-controller="message-actions"
      data-message-actions-node-id-value="<%= node_id %>"
      data-message-actions-role-value="agent"
      data-message-actions-action-policy-value="<%= action_policy_json %>">
      <div class="max-w-[85%]">
        <div
          data-role="agent-bubble"
          data-node-id="<%= node_id %>"
          data-turn-id="<%= turn_id %>"
          data-node-state="<%= state %>"
          data-action-policy="<%= action_policy_json %>"
          <% if run_state_json.present? %>
            data-run-state="<%= run_state_json %>"
          <% end %>
          class="bg-base-100 border border-base-300 rounded-3xl px-5 py-3">
          <% if terminal && state == "errored" && error_text.present? %>
            <div class="text-sm text-error"><%= error_text %></div>
          <% elsif terminal && state == "stopped" && reason_text.present? %>
            <div class="text-sm opacity-70"><%= reason_text %></div>
          <% elsif terminal && markdown_source.present? %>
            <div data-controller="markdown">
              <template data-markdown-target="content"><%= markdown_source %></template>
              <div data-markdown-target="output" class="prose prose-sm max-w-none">
                <%= simple_format(markdown_source) %>
              </div>
            </div>
          <% else %>
            <% spinner_hidden = !%w[pending running].include?(state) %>
            <% if run_state.any? %>
              <%= render "conversation_messages/run_state", run_state: run_state %>
            <% end %>
            <span data-role="text" class="block whitespace-pre-wrap text-sm leading-relaxed <%= run_state.any? ? "mt-3" : "" %>"><%= preview %></span>
            <span data-role="spinner" class="loading loading-dots loading-xs ml-1 align-middle <%= spinner_hidden ? "hidden" : "" %>"></span>
          <% end %>
          <div data-role="error" class="mt-2 text-sm text-error hidden"></div>
        </div>

        <div class="mt-1 flex items-center gap-1 opacity-60 group-hover:opacity-100">
          <button type="button"
                  class="btn btn-ghost btn-xs"
                  data-message-actions-target="copyButton"
                  data-action="message-actions#copy">
            <span class="icon-[lucide--copy] size-3"></span>
            Copy
          </button>

          <% if state == DAG::Node::AWAITING_APPROVAL %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="approveButton"
                    data-action="message-actions#approve">
              <span class="icon-[lucide--badge-check] size-3"></span>
              Approve
            </button>
          <% elsif start_action.fetch("available", false) %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="startButton"
                    data-action="message-actions#start">
              <span class="icon-[lucide--play] size-3"></span>
              Start
            </button>
          <% elsif retry_action.fetch("available", false) %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="retryButton"
                    data-action="message-actions#retry">
              <span class="icon-[lucide--refresh-cw] size-3"></span>
              Retry
            </button>
          <% elsif regenerate_action.fetch("available", false) && regenerate_action.fetch("mode", "in_place") != "branch" %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="regenerateButton"
                    data-action="message-actions#regenerate">
              <span class="icon-[lucide--refresh-cw] size-3"></span>
              Regenerate
            </button>
          <% end %>

          <% if swipe_action.fetch("supported", false) %>
            <div class="join <%= swipe_action.fetch("available", false) ? "" : "hidden" %>" data-message-actions-target="swipeNav">
              <button type="button"
                      class="btn btn-ghost btn-xs join-item"
                      title="Previous version"
                      data-message-actions-target="swipeLeft"
                      data-action="message-actions#swipeLeft"
                      <%= "disabled" unless swipe_left_available %>>
                <span class="icon-[lucide--chevron-left] size-3"></span>
              </button>
              <span class="btn btn-ghost btn-xs join-item pointer-events-none font-mono tabular-nums"
                    data-message-actions-target="swipeCount"><%= swipe_current || 0 %> / <%= swipe_total || 0 %></span>
              <button type="button"
                      class="btn btn-ghost btn-xs join-item"
                      title="Next version"
                      data-message-actions-target="swipeRight"
                      data-action="message-actions#swipeRight"
                      <%= "disabled" unless swipe_right_available %>>
                <span class="icon-[lucide--chevron-right] size-3"></span>
              </button>
            </div>
          <% end %>

          <% if branch_action.fetch("supported", false) %>
            <button type="button"
                    class="btn btn-ghost btn-xs"
                    data-message-actions-target="branchButton"
                    data-action="message-actions#branch">
              <span class="icon-[lucide--git-branch] size-3"></span>
              Branch
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif type == Messages::ProductMessage.node_type_key %>
    <div class="flex justify-start">
      <div class="max-w-[85%]">
        <div class="bg-warning/10 border border-warning/30 rounded-3xl px-5 py-3 text-sm text-base-content">
          <div class="whitespace-pre-wrap"><%= output.presence || preview %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
