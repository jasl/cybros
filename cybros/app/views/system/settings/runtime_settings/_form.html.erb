<%= form_with model: runtime_setting, scope: :runtime_setting, url: system_settings_runtime_settings_path, method: :patch, class: "space-y-4 max-w-3xl" do |f| %>
  <% if runtime_setting.errors.any? %>
    <div role="alert" class="alert alert-error">
      <div class="space-y-1">
        <% runtime_setting.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body space-y-4">
      <div>
        <%= label_tag "runtime_setting_default_worker_concurrency", class: "label" do %>
          <span class="label-text">Default worker concurrency</span>
        <% end %>
        <%= text_field_tag "runtime_setting[default_worker_concurrency]", @default_worker_concurrency_input, class: "input input-bordered w-full max-w-xs", inputmode: "numeric" %>
      </div>

      <div>
        <%= label_tag "runtime_setting_agent_workspace_root", class: "label" do %>
          <span class="label-text">Agent workspace root</span>
        <% end %>
        <%= text_field_tag "runtime_setting[agent_workspace_root]", @agent_workspace_root_input, class: "input input-bordered w-full font-mono text-sm", spellcheck: false %>
        <p class="mt-2 text-xs opacity-70">Root directory for operator-owned custom agent source trees.</p>
      </div>

      <div>
        <%= label_tag "runtime_setting_queue_overrides_json", class: "label" do %>
          <span class="label-text">Queue overrides</span>
        <% end %>
        <%= text_area_tag "runtime_setting[queue_overrides_json]", @queue_overrides_json, class: "textarea textarea-bordered w-full font-mono text-sm", rows: 8 %>
        <p class="mt-2 text-xs opacity-70">Enter a JSON object keyed by queue name.</p>
      </div>

      <div>
        <%= label_tag "runtime_setting_alert_thresholds_json", class: "label" do %>
          <span class="label-text">Alert thresholds</span>
        <% end %>
        <%= text_area_tag "runtime_setting[alert_thresholds_json]", @alert_thresholds_json, class: "textarea textarea-bordered w-full font-mono text-sm", rows: 8 %>
        <p class="mt-2 text-xs opacity-70">Enter a JSON object keyed by runtime signal name.</p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="btn btn-primary">Save runtime settings</button>
    <%= link_to "Back", system_settings_runtime_settings_path, class: "btn btn-ghost" %>
  </div>
<% end %>
