<%= form_with model: agent_deployment, url: system_settings_agent_deployments_path, scope: :agent_deployment, class: "space-y-4 max-w-2xl" do |f| %>
  <% if agent_deployment.errors.any? %>
    <div role="alert" class="alert alert-error">
      <span><%= agent_deployment.errors.full_messages.first %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :agent_program_id, class: "label" do %>
      <span class="label-text">Agent program</span>
    <% end %>
    <%= f.select :agent_program_id, agent_programs.map { |program| [program.name, program.id] }, { include_blank: "Select a program" }, class: "select select-bordered w-full" %>
  </div>

  <div>
    <%= f.label :transport_kind, class: "label" do %>
      <span class="label-text">Transport</span>
    <% end %>
    <%= f.select :transport_kind, [["HTTP JSON-RPC", "http_jsonrpc"]], {}, class: "select select-bordered w-full" %>
  </div>

  <div>
    <%= f.label :endpoint_url, class: "label" do %>
      <span class="label-text">Endpoint URL</span>
    <% end %>
    <%= f.text_field :endpoint_url, class: "input input-bordered w-full" %>
    <p class="mt-1 text-xs opacity-70">Leave blank to let Cybros allocate and manage a local endpoint.</p>
  </div>

  <div>
    <%= f.label :deployment_bearer_secret_ref, class: "label" do %>
      <span class="label-text">Deployment bearer</span>
    <% end %>
    <%= f.text_field :deployment_bearer_secret_ref, class: "input input-bordered w-full", required: true %>
  </div>

  <div>
    <%= f.label :deployment_fingerprint, class: "label" do %>
      <span class="label-text">Expected deployment fingerprint</span>
    <% end %>
    <%= f.text_field :deployment_fingerprint, class: "input input-bordered w-full", required: true %>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="btn btn-primary">Register</button>
    <%= link_to "Back", system_settings_agent_deployments_path, class: "btn btn-ghost" %>
  </div>
<% end %>
