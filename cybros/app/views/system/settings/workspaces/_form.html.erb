<%= form_with model: workspace, scope: :workspace, url: system_settings_workspace_path(workspace), method: :patch, class: "space-y-4 max-w-3xl" do %>
  <% if workspace.errors.any? %>
    <div role="alert" class="alert alert-error items-start">
      <ul class="space-y-1 text-sm">
        <% workspace.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body space-y-4">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <div class="text-xs opacity-60">Location</div>
          <div class="text-sm"><%= workspace.execution_location.name %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Root path</div>
          <div class="font-mono text-sm"><%= workspace.root_path %></div>
        </div>
      </div>

      <div>
        <%= label_tag "workspace_status", class: "label" do %>
          <span class="label-text">Status</span>
        <% end %>
        <% status_options = Workspace::STATUSES.map { |status| [status.humanize, status] } %>
        <% unless Workspace::STATUSES.include?(@status_input) || @status_input.blank? %>
          <% status_options << ["Invalid: #{@status_input}", @status_input] %>
        <% end %>
        <%= select_tag "workspace[status]", options_for_select(status_options, @status_input), class: "select select-bordered w-full max-w-xs" %>
      </div>

      <div>
        <%= label_tag "workspace_capability_tags_text", class: "label" do %>
          <span class="label-text">Capability tags</span>
        <% end %>
        <%= text_field_tag "workspace[capability_tags_text]", @capability_tags_text, class: "input input-bordered w-full", placeholder: "git, shell" %>
      </div>

      <div>
        <%= label_tag "workspace_tags_text", class: "label" do %>
          <span class="label-text">Safety tags</span>
        <% end %>
        <%= text_field_tag "workspace[tags_text]", @tags_text, class: "input input-bordered w-full", placeholder: "trusted, protected" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="btn btn-primary">Save workspace</button>
    <%= link_to "Back", system_settings_workspace_path(workspace), class: "btn btn-ghost" %>
  </div>
<% end %>
