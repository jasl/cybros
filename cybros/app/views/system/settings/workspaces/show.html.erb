<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Workspace</h2>
      <div class="text-sm opacity-70"><%= @workspace.name %></div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit workspace", edit_system_settings_workspace_path(@workspace), class: "btn btn-primary btn-sm" %>
      <%= link_to "Back", system_settings_workspaces_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        <div>
          <div class="text-xs opacity-60">Status</div>
          <div class="text-sm"><%= @workspace.status %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Location</div>
          <div class="text-sm"><%= link_to @workspace.execution_location.name, system_settings_execution_location_path(@workspace.execution_location), class: "link link-hover" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Root path</div>
          <div class="font-mono text-sm"><%= @workspace.root_path %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Workspace type</div>
          <div class="text-sm"><%= @workspace.workspace_type %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Capability tags</div>
          <div class="text-sm"><%= Array(@workspace.capability_tags).join(", ").presence || "None" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Safety tags</div>
          <div class="text-sm"><%= Array(@workspace.tags).join(", ").presence || "None" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Location trust group</div>
          <div class="text-sm"><%= @workspace.execution_location.trust_group %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="font-medium">Execution targets</div>
      <div class="mt-3 space-y-2">
        <% @execution_targets.each do |target| %>
          <div class="flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-100 px-3 py-2">
            <div>
              <div class="font-medium"><%= target.name %></div>
              <div class="text-xs opacity-60"><%= target.status %></div>
            </div>
            <%= link_to "View target", system_settings_execution_target_path(target), class: "btn btn-ghost btn-xs" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
