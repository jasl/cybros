<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold">Automations</h2>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body p-0 overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Task</th>
            <th>Agent</th>
            <th>Target</th>
            <th>Permission</th>
            <th>Schedule</th>
            <th>Latest execution</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @automations.each do |automation| %>
            <% latest_execution = @latest_executions[automation.id] %>
            <tr class="hover:bg-base-200/50 transition-colors">
              <td class="font-medium"><%= automation.task_payload["prompt"].presence || automation.id %></td>
              <td>
                <div class="font-medium"><%= automation.agent_program.name %></div>
                <div class="text-sm opacity-70"><%= automation.task_payload["prompt"] %></div>
              </td>
              <td><%= automation.execution_target.name %></td>
              <td><%= automation.permission_mode %></td>
              <td>
                <div class="font-mono text-xs"><%= automation.schedule_rrule || automation.trigger_kind %></div>
                <% if automation.schedule_timezone.present? %>
                  <div class="text-xs opacity-60"><%= automation.schedule_timezone %></div>
                <% end %>
              </td>
              <td>
                <% if latest_execution.present? %>
                  <div class="font-medium"><%= execution_status_label(latest_execution) %></div>
                  <div class="font-mono text-xs opacity-60">
                    <%= link_to latest_execution.id, conversation_path(latest_execution) %>
                  </div>
                  <div class="font-mono text-xs opacity-60"><%= latest_execution.automation_triggered_at&.iso8601 %></div>
                  <% if execution_approval_status(latest_execution) != "not_required" %>
                    <div class="text-xs opacity-60"><%= execution_approval_status(latest_execution) %></div>
                  <% end %>
                <% else %>
                  <span class="opacity-60">No executions yet</span>
                <% end %>
              </td>
              <td class="text-right">
                <%= link_to "View", system_settings_automation_path(automation), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
