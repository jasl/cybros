<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold">Automations</h2>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body p-0 overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Task</th>
            <th>Agent</th>
            <th>Target</th>
            <th>Permission</th>
            <th>Binding</th>
            <th>Schedule</th>
            <th>Latest run</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @automations.each do |automation| %>
            <% latest_run = @latest_runs[automation.id] %>
            <tr class="hover:bg-base-200/50 transition-colors">
              <td class="font-medium"><%= automation.task_payload["prompt"].presence || automation.id %></td>
              <td>
                <div class="font-medium"><%= automation.agent_program.name %></div>
                <div class="text-sm opacity-70"><%= automation.task_payload["prompt"] %></div>
              </td>
              <td><%= automation.execution_target.name %></td>
              <td><%= automation.permission_mode %></td>
              <td>
                <% if automation.conversation.present? %>
                  <span class="font-mono text-xs"><%= automation.conversation.id %></span>
                <% else %>
                  <span class="opacity-60">Standalone</span>
                <% end %>
              </td>
              <td>
                <div class="font-mono text-xs"><%= automation.schedule_rrule || automation.trigger_kind %></div>
                <% if automation.schedule_timezone.present? %>
                  <div class="text-xs opacity-60"><%= automation.schedule_timezone %></div>
                <% end %>
              </td>
              <td>
                <% if latest_run.present? %>
                  <div class="font-medium"><%= latest_run.status %></div>
                  <div class="font-mono text-xs opacity-60"><%= latest_run.scheduled_for.iso8601 %></div>
                <% else %>
                  <span class="opacity-60">No runs yet</span>
                <% end %>
              </td>
              <td class="text-right">
                <%= link_to "View", system_settings_automation_path(automation), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
