<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold"><%= @automation.task_payload["prompt"].presence || "Automation" %></h2>
      <div class="text-sm opacity-70 font-mono"><%= @automation.id %></div>
    </div>
    <%= link_to "Back", system_settings_automations_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-xs opacity-60">Automation status</div>
          <div class="text-sm"><%= @automation.status %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Permission</div>
          <div class="text-sm"><%= @automation.permission_mode %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Agent program</div>
          <div class="text-sm"><%= @automation.agent_program.name %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Execution target</div>
          <div class="text-sm"><%= @automation.execution_target.name %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Executions</div>
          <div class="text-sm"><%= @execution_conversations.size %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Schedule</div>
          <div class="font-mono text-sm"><%= @automation.schedule_rrule || @automation.trigger_kind %></div>
          <% if @automation.schedule_timezone.present? %>
            <div class="text-xs opacity-60"><%= @automation.schedule_timezone %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body p-0 overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Triggered at</th>
            <th>Status</th>
            <th>Approval</th>
            <th>Conversation</th>
            <th>Dispatch key</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @execution_conversations.each do |conversation| %>
            <% approval_status = execution_approval_status(conversation) %>
            <tr class="hover:bg-base-200/50 transition-colors">
              <td class="font-mono text-xs"><%= conversation.automation_triggered_at&.iso8601 %></td>
              <td class="font-medium"><%= execution_status_label(conversation) %></td>
              <td>
                <div class="font-medium"><%= approval_status %></div>
                <% if execution_approval_reason(conversation).present? %>
                  <div class="text-xs opacity-60"><%= execution_approval_reason(conversation) %></div>
                <% end %>
              </td>
              <td class="font-mono text-xs"><%= link_to conversation.id, conversation_path(conversation) %></td>
              <td class="font-mono text-xs"><%= conversation.automation_dispatch_key %></td>
              <td class="text-right">
                <% if execution_status_label(conversation) == "awaiting_approval" %>
                  <div class="flex items-center justify-end gap-2">
                    <%= button_to "Approve",
                                  approve_system_settings_automation_execution_path(@automation, conversation),
                                  method: :post,
                                  class: "btn btn-primary btn-sm" %>
                    <%= button_to "Reject",
                                  reject_system_settings_automation_execution_path(@automation, conversation),
                                  method: :post,
                                  class: "btn btn-ghost btn-sm" %>
                  </div>
                <% else %>
                  <span class="text-xs opacity-60">No actions</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
