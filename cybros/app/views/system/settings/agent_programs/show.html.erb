<div class="space-y-6">
  <h2 class="text-lg font-semibold"><%= @agent_program.name %></h2>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-xs opacity-60">Source kind</div>
          <div class="font-mono text-sm"><%= @agent_program.source_kind %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Bundled key</div>
          <div class="font-mono text-sm"><%= @agent_program.bundled_agent_key.presence || "n/a" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Local path</div>
          <div class="font-mono text-sm"><%= @agent_program.local_path %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Runtime surface</div>
          <div class="font-mono text-sm"><%= @loaded.runtime_surface_config.fetch("type", "noop") %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Runtime status</div>
          <div class="text-sm">
            <% if @loaded.runtime_surface_status == "configured" %>
              Configured
            <% else %>
              Fallback to safe no-op
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
