<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Execution Locations</h2>
      <p class="text-sm opacity-70">Host-level capacity policy and runtime metadata.</p>
    </div>
    <%= link_to "Back to targets", system_settings_execution_targets_path, class: "btn btn-ghost btn-sm" %>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body p-0 overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Platform</th>
            <th>Environment</th>
            <th>Capacity</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @execution_locations.each do |location| %>
            <tr class="hover:bg-base-200/50 transition-colors">
              <td>
                <div class="font-medium"><%= location.name %></div>
                <div class="text-xs opacity-60"><%= location.trust_group %></div>
              </td>
              <td class="font-mono text-xs"><%= "#{location.kind}/#{location.platform}" %></td>
              <td>
                <div class="text-sm"><%= location.environment %></div>
                <div class="text-xs opacity-60"><%= Array(location.tags).join(", ").presence || "No tags" %></div>
              </td>
              <td class="text-sm">
                <%= "run=#{location.max_concurrent_tasks}, queue=#{location.max_queued_tasks}, timeout=#{location.default_timeout_s}s" %>
              </td>
              <td><%= location.status %></td>
              <td class="text-right">
                <%= link_to "View", system_settings_execution_location_path(location), class: "btn btn-ghost btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
