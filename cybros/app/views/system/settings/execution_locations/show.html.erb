<div class="space-y-6">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Execution Location</h2>
      <div class="text-sm opacity-70"><%= @execution_location.name %></div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit location", edit_system_settings_execution_location_path(@execution_location), class: "btn btn-primary btn-sm" %>
      <%= link_to "Back", system_settings_execution_locations_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        <div>
          <div class="text-xs opacity-60">Status</div>
          <div class="text-sm"><%= @execution_location.status %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Kind</div>
          <div class="text-sm"><%= @execution_location.kind %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Platform</div>
          <div class="font-mono text-sm"><%= @execution_location.platform %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Environment</div>
          <div class="text-sm"><%= @execution_location.environment %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Trust group</div>
          <div class="text-sm"><%= @execution_location.trust_group %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Tags</div>
          <div class="text-sm"><%= Array(@execution_location.tags).join(", ").presence || "None" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Max concurrent tasks</div>
          <div class="text-sm font-medium"><%= @execution_location.max_concurrent_tasks %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Max queued tasks</div>
          <div class="text-sm font-medium"><%= @execution_location.max_queued_tasks %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Default timeout (seconds)</div>
          <div class="text-sm font-medium"><%= @execution_location.default_timeout_s %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">CPU limit</div>
          <div class="text-sm"><%= @execution_location.cpu_limit_millicores.presence || "Unbounded" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Memory limit</div>
          <div class="text-sm"><%= @execution_location.memory_limit_mb.presence || "Unbounded" %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
    <div class="card bg-base-200/30 border border-base-300 shadow-sm">
      <div class="card-body">
        <div class="font-medium">Execution targets</div>
        <div class="mt-3 space-y-2">
          <% @execution_targets.each do |target| %>
            <div class="flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-100 px-3 py-2">
              <div>
                <div class="font-medium"><%= target.name %></div>
                <div class="text-xs opacity-60"><%= target.workspace.name %></div>
              </div>
              <%= link_to "View target", system_settings_execution_target_path(target), class: "btn btn-ghost btn-xs" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card bg-base-200/30 border border-base-300 shadow-sm">
      <div class="card-body">
        <div class="font-medium">Workspaces</div>
        <div class="mt-3 space-y-2">
          <% @workspaces.each do |workspace| %>
            <div class="rounded-box border border-base-300 bg-base-100 px-3 py-2">
              <div class="font-medium"><%= link_to workspace.name, system_settings_workspace_path(workspace), class: "link link-hover" %></div>
              <div class="text-xs opacity-60 font-mono"><%= workspace.root_path %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
