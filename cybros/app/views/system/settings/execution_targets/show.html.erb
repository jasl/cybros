<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-semibold"><%= @execution_target.name %></h2>
    <div class="flex items-center gap-2">
      <%= link_to "Edit target", edit_system_settings_execution_target_path(@execution_target), class: "btn btn-primary btn-sm" %>
      <%= link_to "Back", system_settings_execution_targets_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-xs opacity-60">Status</div>
          <div class="text-sm"><%= @execution_target.status %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Sandboxed</div>
          <div class="text-sm"><%= @execution_target.sandboxed? ? "Yes" : "No" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Execution location</div>
          <div class="text-sm"><%= link_to @execution_target.execution_location.name, system_settings_execution_location_path(@execution_target.execution_location), class: "link link-hover" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Workspace</div>
          <div class="font-mono text-sm"><%= link_to @execution_target.workspace.root_path, system_settings_workspace_path(@execution_target.workspace), class: "link link-hover" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Capabilities</div>
          <div class="text-sm"><%= Array(@execution_target.workspace.capability_tags).join(", ").presence || "None" %></div>
        </div>
        <div>
          <div class="text-xs opacity-60">Quota overrides</div>
          <div class="text-sm">
            <%= [
              ("concurrency=#{@execution_target.max_concurrent_tasks_override}" if @execution_target.max_concurrent_tasks_override.present?),
              ("queue=#{@execution_target.max_queued_tasks_override}" if @execution_target.max_queued_tasks_override.present?),
              ("timeout=#{@execution_target.default_timeout_s_override}s" if @execution_target.default_timeout_s_override.present?),
            ].compact.join(", ").presence || "Inherited from location" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-200/30 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="font-medium">Execution capacity policy</div>
      <div class="mt-4 overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Setting</th>
              <th>Effective</th>
              <th>Source</th>
              <th>Location baseline</th>
            </tr>
          </thead>
          <tbody>
            <% [
              ["Max concurrent tasks", @execution_target.max_concurrent_tasks_override, @execution_target.execution_location.max_concurrent_tasks],
              ["Max queued tasks", @execution_target.max_queued_tasks_override, @execution_target.execution_location.max_queued_tasks],
              ["Default timeout", @execution_target.default_timeout_s_override, @execution_target.execution_location.default_timeout_s],
            ].each do |label, override_value, inherited_value| %>
              <tr>
                <td class="font-medium"><%= label %></td>
                <td><%= override_value.presence || inherited_value %></td>
                <td><%= override_value.present? ? "Override" : "Inherited" %></td>
                <td><%= inherited_value %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
