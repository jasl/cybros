<% if llm_provider.credential_type == "api_key" %>
  <%= form_with model: llm_provider, scope: :llm_provider, url: system_settings_llm_provider_path(llm_provider.provider_key), method: :patch, class: "space-y-4" do |f| %>
    <% if llm_provider.errors.any? %>
      <div role="alert" class="alert alert-error">
        <span><%= llm_provider.errors.full_messages.first %></span>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-4">
      <div>
        <div class="text-xs opacity-60">Provider key</div>
        <div class="font-mono text-sm"><%= llm_provider.provider_key %></div>
      </div>

      <div>
        <div class="text-xs opacity-60">Credential type</div>
        <div class="font-mono text-sm"><%= llm_provider.credential_type %></div>
      </div>

      <div>
        <%= f.label :api_key, class: "label" do %>
          <span class="label-text">API key</span>
        <% end %>
        <%= f.password_field :api_key, class: "input input-bordered w-full", placeholder: (llm_provider.persisted? ? "(unchanged)" : "") %>
        <p class="text-xs opacity-70 mt-2">Leave blank to keep the existing key.</p>
      </div>

      <div class="divider my-0">Limiter</div>

      <div>
        <%= f.label :max_concurrent_requests, class: "label" do %>
          <span class="label-text">Max concurrent requests</span>
        <% end %>
        <%= f.number_field :max_concurrent_requests, class: "input input-bordered w-full", min: 1 %>
      </div>

      <div>
        <%= f.label :requests_per_minute, class: "label" do %>
          <span class="label-text">Requests per minute</span>
        <% end %>
        <%= f.number_field :requests_per_minute, class: "input input-bordered w-full", min: 1 %>
      </div>

      <div>
        <%= f.label :tokens_per_minute, class: "label" do %>
          <span class="label-text">Tokens per minute</span>
        <% end %>
        <%= f.number_field :tokens_per_minute, class: "input input-bordered w-full", min: 1 %>
      </div>

      <div>
        <%= f.label :burst_limit, class: "label" do %>
          <span class="label-text">Burst limit</span>
        <% end %>
        <%= f.number_field :burst_limit, class: "input input-bordered w-full", min: 1 %>
      </div>

      <div>
        <%= label_tag "llm_provider_backoff_policy_json", class: "label" do %>
          <span class="label-text">Backoff policy</span>
        <% end %>
        <%= text_area_tag "llm_provider[backoff_policy_json]", @backoff_policy_json, class: "textarea textarea-bordered w-full font-mono text-sm", rows: 6 %>
        <p class="text-xs opacity-70 mt-2">Enter a JSON object with the provider retry policy.</p>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Save</button>
      <%= link_to "Back", system_settings_llm_providers_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
<% else %>
  <div class="space-y-4">
    <div class="grid grid-cols-1 gap-4">
      <div>
        <div class="text-xs opacity-60">Provider key</div>
        <div class="font-mono text-sm"><%= llm_provider.provider_key %></div>
      </div>

      <div>
        <div class="text-xs opacity-60">Credential type</div>
        <div class="font-mono text-sm"><%= llm_provider.credential_type %></div>
      </div>
    </div>

    <% flow = @device_flow %>
    <div class="card bg-base-200/30 border border-base-300 shadow-sm">
      <div class="card-body">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="font-medium">Device flow (Codex subscription)</div>
            <div class="text-xs opacity-70">Open the link, enter the code, then poll to complete.</div>
          </div>
          <div class="flex items-center gap-2">
            <% if flow.is_a?(Hash) && flow["device_auth_id"].to_s.present? %>
              <%= button_to "Poll", device_flow_poll_system_settings_llm_provider_path(llm_provider.provider_key), method: :post, class: "btn btn-secondary btn-sm" %>
            <% end %>
            <%= button_to "Start", device_flow_start_system_settings_llm_provider_path(llm_provider.provider_key), method: :post, class: "btn btn-secondary btn-sm" %>
          </div>
        </div>

        <% if flow.is_a?(Hash) && flow["device_auth_id"].to_s.present? %>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <div class="text-xs opacity-60">Verification URL</div>
              <% url = flow["verification_uri_complete"].presence || flow["verification_uri"].to_s %>
              <div class="mt-1">
                <%= link_to url, url, class: "link link-primary break-all", target: "_blank", rel: "noreferrer" %>
              </div>
            </div>
            <div>
              <div class="text-xs opacity-60">User code</div>
              <div class="mt-1 font-mono text-lg"><%= flow["user_code"].to_s %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card bg-base-200/30 border border-base-300 shadow-sm">
      <div class="card-body">
        <div class="flex items-center justify-between gap-3">
          <div class="font-medium">Connection status</div>
          <% connected = llm_provider.refresh_token.to_s.present? || llm_provider.access_token.to_s.present? %>
          <span class="badge <%= connected ? "badge-success" : "badge-warning" %>"><%= connected ? "Connected" : "Not connected" %></span>
        </div>

        <% if connected %>
          <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs opacity-60">Account ID</div>
              <div class="font-mono"><%= llm_provider.account_id.to_s.presence || "(none)" %></div>
            </div>
            <div>
              <div class="text-xs opacity-60">Expires at</div>
              <div class="font-mono"><%= llm_provider.expires_at&.iso8601 || "(unknown)" %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%= form_with model: llm_provider, scope: :llm_provider, url: system_settings_llm_provider_path(llm_provider.provider_key), method: :patch, class: "space-y-4" do |f| %>
      <% if llm_provider.errors.any? %>
        <div role="alert" class="alert alert-error">
          <span><%= llm_provider.errors.full_messages.first %></span>
        </div>
      <% end %>

      <div class="card bg-base-200/30 border border-base-300 shadow-sm">
        <div class="card-body space-y-4">
          <div>
            <div class="font-medium">Limiter</div>
            <div class="text-xs opacity-70">These limits govern requests admitted through this credential.</div>
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
              <%= f.label :max_concurrent_requests, class: "label" do %>
                <span class="label-text">Max concurrent requests</span>
              <% end %>
              <%= f.number_field :max_concurrent_requests, class: "input input-bordered w-full", min: 1 %>
            </div>

            <div>
              <%= f.label :requests_per_minute, class: "label" do %>
                <span class="label-text">Requests per minute</span>
              <% end %>
              <%= f.number_field :requests_per_minute, class: "input input-bordered w-full", min: 1 %>
            </div>

            <div>
              <%= f.label :tokens_per_minute, class: "label" do %>
                <span class="label-text">Tokens per minute</span>
              <% end %>
              <%= f.number_field :tokens_per_minute, class: "input input-bordered w-full", min: 1 %>
            </div>

            <div>
              <%= f.label :burst_limit, class: "label" do %>
                <span class="label-text">Burst limit</span>
              <% end %>
              <%= f.number_field :burst_limit, class: "input input-bordered w-full", min: 1 %>
            </div>
          </div>

          <div>
            <%= label_tag "llm_provider_backoff_policy_json", class: "label" do %>
              <span class="label-text">Backoff policy</span>
            <% end %>
            <%= text_area_tag "llm_provider[backoff_policy_json]", @backoff_policy_json, class: "textarea textarea-bordered w-full font-mono text-sm", rows: 6 %>
            <p class="text-xs opacity-70 mt-2">Enter a JSON object with the provider retry policy.</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button type="submit" class="btn btn-primary">Save limiter settings</button>
        <%= link_to "Back", system_settings_llm_providers_path, class: "btn btn-ghost" %>
      </div>
    <% end %>

    <div class="flex items-center gap-3">
      <%= link_to "Back", system_settings_llm_providers_path, class: "btn btn-ghost" %>
    </div>
  </div>
<% end %>
