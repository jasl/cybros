<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<% content_for :right_sidebar do %>
  <div class="h-14 px-2 border-b border-base-300 bg-base-100">
  </div>

  <div class="p-4 space-y-4">
    <ul class="menu bg-base-200 rounded-box w-full">
      <li>
        <%= link_to settings_profile_path, class: "gap-2" do %>
          <span class="icon-[lucide--user] size-4"></span>
          Profile
        <% end %>
      </li>
      <li>
        <%= link_to settings_sessions_path, class: "gap-2" do %>
          <span class="icon-[lucide--monitor-smartphone] size-4"></span>
          Sessions
        <% end %>
      </li>
      <% if Current.user&.owner? || Current.user&.admin? %>
        <li class="menu-title mt-2"><span>System</span></li>
        <li>
          <%= link_to system_settings_llm_providers_path, class: "gap-2" do %>
            <span class="icon-[lucide--cpu] size-4"></span>
            LLM Providers
          <% end %>
        </li>
        <li>
          <%= link_to dashboard_path, class: "gap-2" do %>
            <span class="icon-[lucide--sparkles] size-4"></span>
            Agents
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% content_for :header_content do %>
  <div class="flex items-center gap-2 min-w-0">
    <div class="truncate text-sm font-semibold"><%= @conversation.title.presence || "(untitled)" %></div>
    <span class="badge badge-outline badge-sm opacity-70">Chat</span>
  </div>
<% end %>

<% content_for :header_actions do %>
  <button type="button"
          class="btn btn-ghost btn-sm btn-square"
          data-controller="dialog"
          data-dialog-id-value="hotkeys_help_modal"
          data-action="click->dialog#open"
          title="Keyboard shortcuts (?)"
          aria-label="Keyboard shortcuts">
    <span class="icon-[lucide--help-circle] size-5" aria-hidden="true"></span>
  </button>
<% end %>

<%= turbo_stream_from [@conversation, :messages] %>

<div
  class="h-full flex flex-col"
  data-controller="conversation-channel connectivity-health chat-scroll chat-hotkeys<%= Rails.env.development? ? " debug-overlay" : "" %>"
  data-action="conversation-channel:debug->debug-overlay#update"
  data-conversation-channel-conversation-id-value="<%= @conversation.id %>"
  data-chat-scroll-load-more-url-value="<%= conversation_messages_path(@conversation) %>">
  <div
    class="flex-1 min-h-0 overflow-auto scrollbar-auto-hide bg-base-100"
    data-conversation-channel-target="scroll"
    data-chat-scroll-target="scroll">
    <div class="max-w-3xl mx-auto px-4 py-6 space-y-5">
      <%= render "conversation_messages/load_more",
        conversation: @conversation,
        has_more: @has_more,
        before_cursor: @before_cursor %>

      <%= render "conversation_messages/empty_state", conversation: @conversation, messages: @messages %>
      <%= render "conversation_messages/list", conversation: @conversation, messages: @messages %>
    </div>
  </div>

  <div class="border-t border-base-300 bg-base-100 px-4 py-3">
    <div class="max-w-3xl mx-auto space-y-2">
      <div role="alert" class="alert alert-warning text-sm hidden" data-connectivity-health-target="disconnectedAlert">
        <span class="icon-[lucide--wifi-off] size-4"></span>
        <span class="flex-1">
          Realtime disconnected. Trying to reconnect…
          <span class="opacity-70" data-connectivity-health-target="disconnectedDetail"></span>
        </span>
      </div>

      <div role="alert" class="alert alert-warning text-sm hidden" data-conversation-channel-target="stuckAlert">
        <span>Streaming seems stuck. You can stop generation if it does not recover.</span>
      </div>

      <% message_form_id = dom_id(@conversation, :message_form) %>
      <% managed_subagent_read_only = @conversation.managed_subagent_read_only? %>
      <% managed_subagent_thread = @conversation.managed_subagent_thread %>
      <% if managed_subagent_read_only && managed_subagent_thread.present? %>
        <div
          role="alert"
          class="alert alert-info text-sm"
          data-testid="managed-subagent-banner">
          <span class="icon-[lucide--workflow] size-4"></span>
          <span class="flex-1">
            This subagent is managed by its owner conversation.
            <%= link_to "Open owner", conversation_path(managed_subagent_thread.owner_conversation), class: "link link-primary", data: { testid: "managed-subagent-owner-link" } %>
          </span>
        </div>
      <% end %>
	      <%= form_with url: conversation_messages_path(@conversation),
	        method: :post,
	        multipart: true,
	        html: { id: message_form_id },
	        data: {
            controller: "message-form",
            action: "submit->message-form#submit turbo:submit-end->message-form#submitEnd",
            message_form_composer_draft_url_value: conversation_composer_draft_path(@conversation),
          } do %>
        <% needs_model_reselection = @model_picker_alert_message.present? && @selected_model_ref.blank? %>
        <% if @model_picker_alert_message.present? %>
          <div role="alert" class="alert alert-warning alert-soft text-sm">
            <span><%= @model_picker_alert_message %></span>
          </div>
        <% end %>

        <%= render "conversations/composer_status_rail", conversation: @conversation, composer_state: @composer_state %>
        <div
          role="alert"
          class="alert alert-warning text-sm hidden"
          data-testid="conversation-composer-retry-alert"
          data-conversation-channel-target="retryAlert">
          <span class="icon-[lucide--triangle-alert] size-4"></span>
          <span class="flex-1">The latest assistant run did not finish. Retry it or ignore this alert.</span>
          <div class="flex items-center gap-1">
            <button
              type="button"
              class="btn btn-ghost btn-xs"
              data-testid="conversation-composer-retry-action"
              data-conversation-channel-target="retryButton"
              data-action="click->conversation-channel#retry">
              Retry
            </button>
            <button
              type="button"
              class="btn btn-ghost btn-xs"
              data-testid="conversation-composer-ignore-action"
              data-action="click->conversation-channel#ignoreRetry">
              Ignore
            </button>
          </div>
        </div>
        <div
          class="hidden items-center justify-between rounded-2xl border border-base-300 bg-base-200/70 px-3 py-2 text-xs"
          data-message-form-target="editMode">
          <span data-message-form-target="editModeLabel">Editing your last message. Sending will regenerate the latest assistant reply.</span>
          <button
            type="button"
            class="btn btn-ghost btn-xs"
            data-action="message-form#cancelEdit">
            Cancel
          </button>
        </div>
        <input
          type="hidden"
          name="input_policy_override[running_input_policy]"
          value=""
          disabled
          data-message-form-target="runningInputPolicyInput">
        <input
          type="hidden"
          name="input_policy_override[input_coalescing][enabled]"
          value="false">
        <input
          type="hidden"
          name="interrupted_output_policy_override"
          value="">
        <input
          type="hidden"
          name="edit_node_id"
          value=""
          disabled
          data-message-form-target="editNodeIdInput">
        <input
          type="hidden"
          name="composer_draft_updated_at"
          value="<%= @composer_draft_updated_at %>"
          data-message-form-target="composerDraftUpdatedAtInput">

        <div
          class="hidden rounded-3xl border border-base-300 bg-base-100 px-3 py-3"
          data-testid="conversation-composer-attachments"
          data-message-form-target="attachmentPanel">
          <div class="flex items-center justify-between gap-2">
            <div class="text-xs font-medium text-base-content/80">Attachments</div>
            <div class="text-xs opacity-60" data-message-form-target="attachmentCount"></div>
          </div>
          <div class="mt-3 flex flex-col gap-2" data-message-form-target="attachmentList"></div>
          <div
            class="mt-3 hidden rounded-2xl border border-base-300 bg-base-200/70 px-3 py-2 text-xs text-pretty"
            data-testid="conversation-composer-vision-hint"
            data-message-form-target="attachmentModelHint"></div>
        </div>

        <template data-message-form-target="attachmentItemTemplate">
          <div
            class="flex items-center gap-3 rounded-2xl border border-base-300 bg-base-200/70 px-3 py-2"
            data-testid="conversation-composer-attachment">
            <div
              class="hidden size-12 shrink-0 overflow-hidden rounded-2xl border border-base-300 bg-base-100"
              data-role="preview">
              <img alt="" class="size-full object-cover" data-role="image">
            </div>
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-medium" data-role="name"></div>
              <div class="mt-1 text-xs opacity-70 text-pretty" data-role="meta"></div>
            </div>
            <button
              type="button"
              class="btn btn-ghost btn-xs btn-square shrink-0"
              aria-label="Remove attachment"
              data-role="remove"
              data-action="message-form#removeAttachment">
              <span class="icon-[lucide--x] size-3"></span>
            </button>
          </div>
        </template>

        <div
          data-testid="conversation-composer-input"
          class="bg-base-200 rounded-3xl pl-5 pr-2 py-2 flex items-end gap-2 focus-within:ring-2 focus-within:ring-primary/40 focus-within:ring-offset-2 focus-within:ring-offset-base-100">
          <label class="btn btn-ghost btn-circle btn-sm shrink-0 mb-0.5" aria-label="Add files">
            <span class="icon-[lucide--paperclip] size-4"></span>
	            <input
	              type="file"
	              name="attachments[]"
	              multiple
                <%= "disabled" if managed_subagent_read_only %>
	              class="hidden"
	              data-message-form-target="attachmentInput"
	              data-action="click->message-form#prepareAttachmentSelection change->message-form#attachmentInputChanged">
	          </label>
          <textarea
            name="content"
            rows="1"
            class="bg-transparent flex-1 resize-none py-1.5 text-sm placeholder:opacity-40 min-h-6 max-h-48 focus-visible:outline-none"
            placeholder="Message…"
            aria-label="Message"
            <%= "disabled" if managed_subagent_read_only %>
            data-message-form-target="textarea"
            data-chat-hotkeys-target="textarea"
            data-action="keydown->message-form#keydown input->message-form#draftChanged"><%= @composer_draft_content %></textarea>
          <button type="submit" class="btn btn-neutral btn-circle btn-sm shrink-0 mb-0.5" aria-label="Send" <%= "disabled" if managed_subagent_read_only %>>
            <span class="icon-[lucide--arrow-up] size-4"></span>
          </button>
        </div>

        <div
          data-testid="conversation-composer-footer"
          class="mt-2.5 flex flex-col gap-2 px-2 pt-1 sm:flex-row sm:items-center sm:justify-between">
          <div
            data-testid="conversation-composer-runtime-controls"
            class="grid min-w-0 flex-1 grid-cols-1 gap-2 sm:grid-cols-[minmax(16rem,1fr)_11rem] sm:items-center">
            <div class="min-w-0">
              <% if @llm_model_options.present? %>
                <select
                  name="model_ref"
                  data-testid="conversation-composer-model-picker"
                  aria-label="Model"
                  form="<%= message_form_id %>"
                  data-message-form-target="modelSelect"
                  data-action="change->message-form#runtimeSettingChanged"
                  <%= needs_model_reselection ? "required" : nil %>
                  <%= "disabled" if managed_subagent_read_only %>
                  class="select select-bordered select-xs w-full min-w-0">
                  <% if needs_model_reselection %>
                    <option value="" selected>Please reselect a model</option>
                  <% end %>
                  <% @llm_model_option_groups.each do |group| %>
                    <optgroup label="<%= group.fetch(:provider_display_name) %>">
                      <% group.fetch(:options).each do |opt| %>
                        <option
                          value="<%= opt.fetch(:model_ref) %>"
                          data-supports-images="<%= opt.fetch(:supports_images, false) %>"
                          <%= opt.fetch(:model_ref) == @selected_model_ref ? "selected" : "" %>>
                          <%= opt.fetch(:label, opt.fetch(:model_display_name)) %>
                        </option>
                      <% end %>
                    </optgroup>
                  <% end %>
                </select>
              <% else %>
                <div class="flex items-center gap-2">
                  <select
                    data-testid="conversation-composer-model-picker"
                    aria-label="Model"
                    class="select select-bordered select-xs min-w-0 flex-1"
                    disabled>
                    <option>No models configured</option>
                  </select>
                  <% if Current.user&.owner? || Current.user&.admin? %>
                    <%= link_to "Configure", system_settings_llm_providers_path, class: "link link-primary shrink-0 text-xs" %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <select
              name="conversation[permission_mode]"
              data-testid="conversation-composer-permission-picker"
              aria-label="Permissions"
              data-action="change->message-form#runtimeSettingChanged"
              <%= "disabled" if managed_subagent_read_only %>
              class="select select-bordered select-xs w-full">
              <% @permission_mode_options.each do |value, label| %>
                <option value="<%= value %>" <%= @selected_permission_mode == value ? "selected" : nil %>>
                  <%= label %>
                </option>
              <% end %>
            </select>

          </div>

          <div class="flex items-center gap-1">
            <button
              type="button"
              class="btn btn-ghost btn-xs hidden"
              data-conversation-channel-target="stopButton"
              data-action="click->conversation-channel#stop">
              <span class="icon-[lucide--square] size-3"></span>
              Stop
            </button>
          </div>
        </div>
      <% end %>

      <% if @selected_agent_stale %>
        <div role="alert" class="alert alert-warning alert-soft text-sm mt-2" data-testid="conversation-agent-stale-warning">
          <span>Selected agent has no active healthy deployment. Future runs will stay blocked until the operator restores this deployment.</span>
        </div>
      <% end %>
    </div>
  </div>

  <% if Rails.env.development? %>
    <div
      class="fixed bottom-4 right-4 z-50 hidden"
      data-debug-overlay-target="panel">
      <div class="card bg-base-100 border border-base-300 shadow-lg">
        <div class="card-body p-4 space-y-2">
          <div class="text-xs font-semibold opacity-70">Stream debug (Ctrl+Shift+D)</div>
          <div class="text-xs">
            <span class="opacity-60">cursor</span>
            <span class="font-mono" data-debug-overlay-target="cursor"></span>
          </div>
          <div class="text-xs">
            <span class="opacity-60">active node</span>
            <span class="font-mono" data-debug-overlay-target="activeNode"></span>
          </div>
          <div class="text-xs">
            <span class="opacity-60">last event</span>
            <span class="font-mono" data-debug-overlay-target="lastEvent"></span>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
