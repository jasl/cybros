web: RUBY_DEBUG_OPEN=true CYBROS_MANAGED_AGENT_AUTOLAUNCH=1 CYBROS_AGENT_WORKSPACE_ROOT=$PWD/tmp/agent-workspace CYBROS_DEFAULT_EXECUTION_WORKSPACE_ROOT=$PWD bin/rails server -b 0.0.0.0
job: RUBY_DEBUG_OPEN=true CYBROS_MANAGED_AGENT_AUTOLAUNCH=1 CYBROS_AGENT_WORKSPACE_ROOT=$PWD/tmp/agent-workspace CYBROS_DEFAULT_EXECUTION_WORKSPACE_ROOT=$PWD bin/jobs
agents: RUBY_DEBUG_OPEN=true CYBROS_MANAGED_AGENT_AUTOLAUNCH=1 CYBROS_AGENT_WORKSPACE_ROOT=$PWD/tmp/agent-workspace CYBROS_DEFAULT_EXECUTION_WORKSPACE_ROOT=$PWD bin/managed_agent_deployments
js: bun run build --watch
css: bun run build:css --watch
