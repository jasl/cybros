web: RUBY_DEBUG_OPEN=true CYBROS_AGENT_WORKSPACE_ROOT=$PWD/tmp/agent-workspace CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL:-http://127.0.0.1:4242/rpc} CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER:-secret://bundled-claw:dev} CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT:-deployment:bundled-claw:dev} bin/rails server -b 0.0.0.0
job: RUBY_DEBUG_OPEN=true CYBROS_AGENT_WORKSPACE_ROOT=$PWD/tmp/agent-workspace CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_ENDPOINT_URL:-http://127.0.0.1:4242/rpc} CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER:-secret://bundled-claw:dev} CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT:-deployment:bundled-claw:dev} bin/jobs
claw: cd ../agents/claw && rm -f tmp/pids/server.pid && BUNDLE_GEMFILE=$PWD/Gemfile CLAW_REQUIRED_BEARER=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_BEARER:-secret://bundled-claw:dev} CLAW_DEPLOYMENT_FINGERPRINT=${CYBROS_BOOTSTRAP_BUNDLED_CLAW_FINGERPRINT:-deployment:bundled-claw:dev} CLAW_WORKSPACE_ROOT=$OLDPWD/tmp/agent-workspace/bundled/claw PORT=${CYBROS_BUNDLED_CLAW_PORT:-4242} bin/rails server -b 127.0.0.1
js: bun run build --watch
css: bun run build:css --watch
