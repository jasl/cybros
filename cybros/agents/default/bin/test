#!/usr/bin/env ruby
root = File.expand_path("..", __dir__)
tests = [
  File.join(root, "test/unit/manifest_test.rb"),
  File.join(root, "test/integration/rpc_contract_test.rb"),
]

exec(
  "bundle",
  "exec",
  "ruby",
  "-I#{File.join(root, "test")}",
  "-e",
  "ARGV.each { |path| load File.expand_path(path) }",
  *tests
)
