#!/usr/bin/env ruby

require "pathname"

app_root = Pathname.new(__dir__).join("..").expand_path
ENV["BUNDLE_GEMFILE"] ||= app_root.join("Gemfile").to_s
Dir.chdir(app_root)

default_test_files = %w[
  test/unit/bin_test_script_test.rb
  test/unit/manifest_test.rb
  test/integration/rpc_contract_test.rb
  test/requests/http_boundary_test.rb
].freeze

exec "bundle", "exec", "rails", "test", *(ARGV.empty? ? default_test_files : ARGV)
